#: JCOM-theme/templates/admin/core/accounts/password_guide.html:5
#: JCOM-theme/templates/admin/core/accounts/register.html:106
msgid "Password Guide"
msgstr "Guía de contraseñas"

#: JCOM-theme/templates/admin/core/accounts/password_guide.html:6
#: JCOM-theme/templates/admin/core/accounts/register.html:107
msgid "When it comes to passwords, length is better than complexity."
msgstr ""
"En lo que respecta a las contraseñas, es mejor que sean largas que "
"complejas."

#: JCOM-theme/templates/admin/core/accounts/password_guide.html:7
#: JCOM-theme/templates/admin/core/accounts/register.html:108
msgid ""
"Its a common myth that a short and complex password (Jfjfy&65^87) is more "
"secure than a long and uncomplicated password (our awesome moon base rocks)."
msgstr ""
"Es un mito común que una contraseña corta y compleja (Jfjfy&65^87) sea más "
"segura que una contraseña larga y sencilla (nuestra increíble base lunar es "
"genial)."

#: JCOM-theme/templates/admin/core/accounts/password_guide.html:8
msgid ""
"We recommend selecting a long, but easy to remember password such as <i>our awesome moon base\n"
"      rocks</i> which would take an estimated septillion years to crack as opposed to a complex one\n"
"      like <i>Jfjfy&65^87</i> which would take just over 600 years on a standard computer."
msgstr ""
"Le recomendamos elegir una contraseña larga, pero fácil de recordar, como "
"<i>nuestra increíble base lunar es genial</i>, que tardaría un septillón de "
"años estimado en descifrarse, frente a una compleja como <i>Jfjfy&65^87</i>,"
" que tardaría poco más de 600 años en un ordenador estándar."

