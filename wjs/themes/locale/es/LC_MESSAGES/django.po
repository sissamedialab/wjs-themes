msgstr "segundo nombre"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:52
msgid "last name"
msgstr "apellido"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:53
msgid "e-mail"
msgstr "correo electrónico"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:54
msgid "institution / affiliation"
msgstr "institución / afiliación"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:55
msgid "contribution title"
msgstr "título de la contribución"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:68
msgid ""
"\n"
"              <p>\n"
"                Warning: if you check \"create articles on import\" the title is mandatory.\n"
"                <br />\n"
"                Warning: only middle name and affiliation are optional. All other fields are mandatory (for the title, see above).\n"
"                <br />\n"
"                Warning: order is important.\n"
"              </p>\n"
"            "
msgstr ""
"\n"
"              <p>\n"
"                Advertencia: si marca «crear artículos al importar», el título es obligatorio.\n"
"                <br />\n"
"                Advertencia: solo el segundo nombre y la afiliación son opcionales. Todos los demás campos son obligatorios (para el título, véase más arriba).\n"
"                <br />\n"
"                Advertencia: el orden es importante.\n"
"              </p>\n"
"            "

