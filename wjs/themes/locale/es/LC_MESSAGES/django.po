"\n"
"              <p>\n"
"                The data file must be an <b>OASIS <a href=\"https://en.wikipedia.org/wiki/OpenDocument\">OpenDocument</a> Spreadsheet</b>\n"
"                (that means \"an OpenOffice 2 version of excel file\") with data on the\n"
"                first sheet and with the following structure:\n"
"              </p>\n"
"            "
msgstr ""
"\n"
"              <p>\n"
"                El archivo de datos debe ser una <b>hoja de cálculo OASIS <a href=\"https://en.wikipedia.org/wiki/OpenDocument\">OpenDocument</a></b>\n"
"                (es decir, «una versión OpenOffice 2 de un archivo de Excel») con los datos en la\n"
"                primera hoja y con la siguiente estructura:\n"
"              </p>\n"
"            "

#: JCOM-theme/templates/admin/core/si_imu_upload.html:42
msgid "session (optional)"
msgstr "sesión (opcional)"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:50
msgid "first name"
msgstr "nombre"

#: JCOM-theme/templates/admin/core/si_imu_upload.html:51
