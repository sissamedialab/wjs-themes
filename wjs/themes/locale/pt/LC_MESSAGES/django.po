#: JCOM-theme/templates/admin/core/si_imu_check.html:58
msgid "first"
msgstr "nome"

#: JCOM-theme/templates/admin/core/si_imu_check.html:59
msgid "middle"
msgstr "nome do meio"

#: JCOM-theme/templates/admin/core/si_imu_check.html:60
msgid "last"
msgstr "apelido"

#: JCOM-theme/templates/admin/core/si_imu_check.html:61
msgid "email"
msgstr "correio eletrónico"

#: JCOM-theme/templates/admin/core/si_imu_check.html:62
msgid "institution"
msgstr "instituição"

#: JCOM-theme/templates/admin/core/si_imu_check.html:63
msgid "title"
msgstr "título"

#: JCOM-theme/templates/admin/core/si_imu_check.html:116
msgid "new"
msgstr "novo"

#: JCOM-theme/templates/admin/core/si_imu_check.html:118
msgid "skip"
msgstr "ignorar"

#: JCOM-theme/templates/admin/core/si_imu_check.html:154
msgid "Import..."
msgstr "Importar..."

#: JCOM-theme/templates/admin/core/si_imu_check.html:162
msgid "Legend"
msgstr "Legenda"

#: JCOM-theme/templates/admin/core/si_imu_check.html:163
msgid ""
"\n"
"            For each row in the uploaded spreadsheet, please mind the "
"following meanings\n"
"            <dl>\n"
"              <dt>new</dt>\n"
"              <dd>\n"
"                create a new account in the DB. Naturally this is not "
"possible if the email is the same as that of an already existing account.\n"
"              </dd>\n"
"              <dt>skip</dt>\n"
"              <dd>\n"
"                just ignore this line and do nothing, as if it was not "
"present in the uploaded spreadsheed.\n"
"              </dd>\n"
"              <dt>DB</dt>\n"
"              <dd>\n"
"                use this existing account without any modification. If "
"articles should be created, this account will be the owner and main author "
"of the new article with the given title.\n"
"              </dd>\n"
"              <dt>edit...</dt>\n"
"              <dd>\n"
"                use this existing account, but let me change something. In "
"the next step, a form will be available where you will be able to edit the "
"account. You will be presented with the current data present in the DB and "
"with the \"new\"\n"
"                ones uploaded with the spreasheet.\n"
"              </dd>\n"
"            </dl>\n"
"          "
msgstr ""
"\n"
"            Para cada linha da folha de cálculo carregada, tenha em conta "
"os seguintes significados\n"
"            <dl>\n"
"              <dt>novo</dt>\n"
"              <dd>\n"
"                cria uma nova conta na base de dados. Naturalmente, isto "
"não é possível se o correio eletrónico for o mesmo de uma conta já "
"existente.\n"
"              </dd>\n"
"              <dt>ignorar</dt>\n"
"              <dd>\n"
"                simplesmente ignora esta linha e não faz nada, como se não "
"estivesse presente na folha de cálculo carregada.\n"
"              </dd>\n"
"              <dt>DB</dt>\n"
"              <dd>\n"
"                usa esta conta existente sem qualquer modificação. Se "
"forem criados artigos, esta conta será a proprietária e o autor principal "
"do novo artigo com o título indicado.\n"
"              </dd>\n"
"              <dt>editar...</dt>\n"
"              <dd>\n"
"                usa esta conta existente, mas permite alterar algo. No "
"passo seguinte, estará disponível um formulário onde poderá editar a "
"conta. Ser-lhe-ão apresentados os dados atuais presentes na base de dados "
"e os «novos»\n"
"                carregados com a folha de cálculo.\n"
"              </dd>\n"
"            </dl>\n"
"          "

