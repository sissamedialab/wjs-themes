#: JCOM-theme/templates/admin/core/accounts/password_guide.html:5
#: JCOM-theme/templates/admin/core/accounts/register.html:106
msgid "Password Guide"
msgstr "Guia de palavras-passe"

#: JCOM-theme/templates/admin/core/accounts/password_guide.html:6
#: JCOM-theme/templates/admin/core/accounts/register.html:107
msgid "When it comes to passwords, length is better than complexity."
msgstr ""
"No que respeita às palavras-passe, é melhor que sejam longas do que "
"complexas."

#: JCOM-theme/templates/admin/core/accounts/password_guide.html:7
#: JCOM-theme/templates/admin/core/accounts/register.html:108
msgid ""
"Its a common myth that a short and complex password (Jfjfy&65^87) is more "
"secure than a long and uncomplicated password (our awesome moon base rocks)."
msgstr ""
"É um mito comum que uma palavra-passe curta e complexa (Jfjfy&65^87) seja "
"mais segura do que uma palavra-passe longa e simples (a nossa incrível base "
"lunar é fantástica)."

#: JCOM-theme/templates/admin/core/accounts/password_guide.html:8
msgid ""
"We recommend selecting a long, but easy to remember password such as <i>our "
"awesome moon base\n"
"      rocks</i> which would take an estimated septillion years to crack as "
"opposed to a complex one\n"
"      like <i>Jfjfy&65^87</i> which would take just over 600 years on a "
"standard computer."
msgstr ""
"Recomendamos escolher uma palavra-passe longa, mas fácil de recordar, como "
"<i>a nossa incrível base lunar é fantástica</i>, que demoraria cerca de um "
"septilião de anos a decifrar, ao contrário de uma complexa como "
"<i>Jfjfy&65^87</i>, que demoraria pouco mais de 600 anos num computador "
"comum."

